 a_bool_t
+qca_ssdk_phydev_to_port_valid(a_uint32_t dev_id, struct phy_device *phydev)
+{
+	a_uint32_t miibus_id = 0, phy_addr_e = 0, port_id;
+
+	if (!phydev)
+		return A_FALSE;
+
+	miibus_id = ssdk_miibus_index_get(dev_id, phydev->mdio.bus);
+	phy_addr_e = TO_PHY_ADDR_E(phydev->mdio.addr, miibus_id);
+	port_id = qca_ssdk_phy_addr_to_port(dev_id, phy_addr_e);
+
+	if (qca_ssdk_port_to_phy_addr(dev_id, port_id) == phy_addr_e)
+		return A_TRUE;
+
+#if defined(IN_PHY_I2C_MODE)
+	if (qca_ssdk_port_to_phy_mdio_fake_address(dev_id, port_id) ==
+		TO_PHY_ADDR(phy_addr_e))
+		return A_TRUE;
+#endif
+
+	return A_FALSE;
+}
