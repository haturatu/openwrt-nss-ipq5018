From 31be4b995837debb2da621e2dd8e9585167eb448 Mon Sep 17 00:00:00 2001
From: haturatu <haturatu@users.noreply.github.com>
Date: Sat, 6 Sep 2026 00:00:00 +0900
Subject: [PATCH] ipq5018: trace ECM TCP rule state before NSS submission

Record the conntrack TCP state copied into an ECM IPv4 rule, then record
the final TCP state immediately before submitting that rule to NSS. The
connection serial links the two records without exposing flow addresses.

This distinguishes an ECM state-transfer issue from NSS firmware sequence
or window validation on IPQ5018.

Signed-off-by: haturatu <haturatu@users.noreply.github.com>
---
 qca-nss-ecm/patches/0030-ipq5018-ecm-tcp-rule-trace.patch | 71 ++++++++++++
 1 file changed, 71 insertions(+)
 create mode 100644 qca-nss-ecm/patches/0030-ipq5018-ecm-tcp-rule-trace.patch

diff --git a/qca-nss-ecm/patches/0030-ipq5018-ecm-tcp-rule-trace.patch b/qca-nss-ecm/patches/0030-ipq5018-ecm-tcp-rule-trace.patch
new file mode 100644
index 0000000..5a7d922
--- /dev/null
+++ b/qca-nss-ecm/patches/0030-ipq5018-ecm-tcp-rule-trace.patch
@@ -0,0 +1,71 @@
+diff --git a/frontends/nss/ecm_nss_ported_ipv4.c b/frontends/nss/ecm_nss_ported_ipv4.c
+index 72aa0d0..14525eb 100644
+--- a/frontends/nss/ecm_nss_ported_ipv4.c
++++ b/frontends/nss/ecm_nss_ported_ipv4.c
+@@ -346,6 +346,19 @@ static void ecm_nss_ported_ipv4_connection_accelerate(struct ecm_front_end_conne
+ 	uint8_t dest_mac_xlate[ETH_ALEN];
+ 	ecm_db_direction_t ecm_dir;
+ 	ecm_front_end_acceleration_mode_t result_mode;
++	struct {
++		bool valid;
++		int flow_dir;
++		int return_dir;
++		uint8_t flow_window_scale;
++		uint32_t flow_max_window;
++		uint32_t flow_end;
++		uint32_t flow_max_end;
++		uint8_t return_window_scale;
++		uint32_t return_max_window;
++		uint32_t return_end;
++		uint32_t return_max_end;
++	} tcp_ct = { 0 };
+ 
+ 	DEBUG_CHECK_MAGIC(feci, ECM_FRONT_END_CONNECTION_INSTANCE_MAGIC, "%px: magic failed", feci);
+ 
+@@ -1231,6 +1244,17 @@ static void ecm_nss_ported_ipv4_connection_accelerate(struct ecm_front_end_conne
+ 
+ 			DEBUG_TRACE("%px: TCP Accel Get window data from ct %px for conn %px\n", feci, ct, feci->ci);
+ 			spin_lock_bh(&ct->lock);
++			tcp_ct.valid = true;
++			tcp_ct.flow_dir = flow_dir;
++			tcp_ct.return_dir = return_dir;
++			tcp_ct.flow_window_scale = ct->proto.tcp.seen[flow_dir].td_scale;
++			tcp_ct.flow_max_window = ct->proto.tcp.seen[flow_dir].td_maxwin;
++			tcp_ct.flow_end = ct->proto.tcp.seen[flow_dir].td_end;
++			tcp_ct.flow_max_end = ct->proto.tcp.seen[flow_dir].td_maxend;
++			tcp_ct.return_window_scale = ct->proto.tcp.seen[return_dir].td_scale;
++			tcp_ct.return_max_window = ct->proto.tcp.seen[return_dir].td_maxwin;
++			tcp_ct.return_end = ct->proto.tcp.seen[return_dir].td_end;
++			tcp_ct.return_max_end = ct->proto.tcp.seen[return_dir].td_maxend;
+ 			nircm->tcp_rule.flow_window_scale = ct->proto.tcp.seen[flow_dir].td_scale;
+ 			nircm->tcp_rule.flow_max_window = ct->proto.tcp.seen[flow_dir].td_maxwin;
+ 			nircm->tcp_rule.flow_end = ct->proto.tcp.seen[flow_dir].td_end;
+@@ -1418,6 +1442,28 @@ static void ecm_nss_ported_ipv4_connection_accelerate(struct ecm_front_end_conne
+ 	/*
+ 	 * Call the rule create function
+ 	 */
++	if (protocol == IPPROTO_TCP) {
++		if (tcp_ct.valid) {
++			pr_info("ECM-TCP-CT: serial=%u flow_dir=%d return_dir=%d flow_ws=%u flow_maxwin=%u flow_end=%u flow_maxend=%u ret_ws=%u ret_maxwin=%u ret_end=%u ret_maxend=%u\n",
++				ecm_db_connection_serial_get(feci->ci), tcp_ct.flow_dir, tcp_ct.return_dir,
++				tcp_ct.flow_window_scale, tcp_ct.flow_max_window,
++				tcp_ct.flow_end, tcp_ct.flow_max_end,
++				tcp_ct.return_window_scale, tcp_ct.return_max_window,
++				tcp_ct.return_end, tcp_ct.return_max_end);
++		} else {
++			pr_info("ECM-TCP-CT: serial=%u source=unavailable\n",
++				ecm_db_connection_serial_get(feci->ci));
++		}
++
++		pr_info("ECM-TCP-RULE: serial=%u flow_if=%d return_if=%d flow_ws=%u flow_maxwin=%u flow_end=%u flow_maxend=%u ret_ws=%u ret_maxwin=%u ret_end=%u ret_maxend=%u rule_flags=0x%x valid_flags=0x%x\n",
++			ecm_db_connection_serial_get(feci->ci),
++			nircm->conn_rule.flow_interface_num, nircm->conn_rule.return_interface_num,
++			nircm->tcp_rule.flow_window_scale, nircm->tcp_rule.flow_max_window,
++			nircm->tcp_rule.flow_end, nircm->tcp_rule.flow_max_end,
++			nircm->tcp_rule.return_window_scale, nircm->tcp_rule.return_max_window,
++			nircm->tcp_rule.return_end, nircm->tcp_rule.return_max_end,
++			nircm->rule_flags, nircm->valid_flags);
++	}
+ 	pr_info_ratelimited("ECM-NSS: rule-submit proto=4 flow_ifnum=%d return_ifnum=%d flow_nexthop=%d return_nexthop=%d\n",
+ 		nircm->conn_rule.flow_interface_num, nircm->conn_rule.return_interface_num,
+ 		nircm->nexthop_rule.flow_nexthop, nircm->nexthop_rule.return_nexthop);
-- 
2.50.1
