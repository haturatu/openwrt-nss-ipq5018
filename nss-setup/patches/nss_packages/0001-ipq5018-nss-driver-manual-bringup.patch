-######################################################################
-### Takes a comma, space separated, or range list of CPU numbers and
-## returns a bitmask of CPUs.
-## cpus_to_bitmask "0,1,2,3" -> f
-## cpus_to_bitmask "0 1 2 3" -> f
-## cpus_to_bitmask "0-3"     -> f
-## cpus_to_bitmask "3"       -> 8
-#######################################################################
-
-cpus_to_bitmask() {
+online_cpu_list() {
+	[ -r /sys/devices/system/cpu/online ] || {
+		printf '0\n'
+		return
+	}
+	awk -F, '
+	{
+		for (i = 1; i <= NF; i++) {
+			split($i, range, "-")
+			start = range[1]
+			end = range[2]
+			if (!end)
+				end = start
+			for (cpu = start; cpu <= end; cpu++) {
+				if (cpus != "")
+					cpus = cpus " "
+				cpus = cpus cpu
+			}
+		}
+	}
+	END { print cpus }
+	' /sys/devices/system/cpu/online
+}
 
-  local bitmask=0
-  # shellcheck disable=2048
-  for range in ${*//,/ }; do
-    start="${range%-*}"
