+	set_affinity xhci-hcd:usb3 "$cpu2" 1
+	set_affinity ppdu-end-interrupts-mac1 "$cpu2" 1
+	set_affinity ppdu-end-interrupts-mac2 "$cpu3" 1
+	set_affinity ppdu-end-interrupts-mac3 "$cpu1" 1
+	set_affinity ath10k_pci "$online_cpus" 1
+
+	if [ -w /proc/sys/dev/nss/rps/enable ]; then
+		printf '1\n' > /proc/sys/dev/nss/rps/enable
+	fi
 }
 
