+cpu_for_index() {
+	local index="$1" cpu
+
+	for cpu in $online_cpus; do
+		[ "$index" -eq 0 ] && {
+			printf '%s\n' "$cpu"
+			return 0
+		}
+		index=$((index - 1))
+	done
+	return 1
 }
 
-######################################################################
-### Sets the affinity of the IRQs with the given name to the given CPU.
-## first argument: IRQ name ("nss_queue0")
-## second argument: CPU number
-## third argument: occurrence of the IRQ name
-##                 since NSS core 0/1 share the same IRQ names
-## set_affinity "nss_queue0" 1 1
+cpus_to_bitmask() {
+	local bitmask=0 cpu_list range start end cpu
+
+	cpu_list=$(printf '%s\n' "$1" | tr ',' ' ')
+	for range in $cpu_list; do
+		case "$range" in
+			*-*)
+				start=${range%-*}
+				end=${range#*-}
+				;;
+			*)
+				start=$range
+				end=$range
+				;;
+		esac
+		cpu=$start
+		while [ "$cpu" -le "$end" ]; do
+			if cpu_is_online "$cpu"; then
+				bitmask=$((bitmask | (1 << cpu)))
+			fi
+			cpu=$((cpu + 1))
+		done
+	done
+
+	[ "$bitmask" -ne 0 ] || return 1
+	printf '%x\n' "$bitmask"
+}
 
 set_affinity() {
-
-  local irq_name="$1" affinity="$2" occurrence="${3:-1}" bitmask
-
-  awk -v irq_name="$irq_name" -v occurrence="$occurrence" '
-    BEGIN{count=0}
-    $NF==irq_name {
-      if(++count==occurrence){
-        sub(/:$/,"",$1)
-        print $1
-      }
-  }' /proc/interrupts | while read -r irq; do
-    $enable_log && {
-      log_msg "$irq_name" "$affinity" "$occurrence" "$irq"
-    }
-    bitmask=$(cpus_to_bitmask "$affinity") && echo "$bitmask" > /proc/irq/"$irq"/smp_affinity
-  done
+	local irq_name="$1" affinity="$2" occurrence="${3:-1}" bitmask irq
+
+	bitmask=$(cpus_to_bitmask "$affinity") || return 0
+	awk -v irq_name="$irq_name" -v occurrence="$occurrence" '
+		BEGIN { count = 0 }
+		$NF == irq_name {
+			if (++count == occurrence) {
+				sub(/:$/, "", $1)
+				print $1
+			}
+		}
+	' /proc/interrupts | while read -r irq; do
+		[ "$enable_log" -eq 1 ] && log_msg "$irq_name" "$affinity" "$occurrence" "$irq"
+		if ! printf '%s\n' "$bitmask" > "/proc/irq/$irq/smp_affinity"; then
+			logger -p user.warn -t "$PROG" "Unable to set IRQ($irq) affinity to $affinity"
+		fi
+	done
 }
 
