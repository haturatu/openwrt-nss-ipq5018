From 8328f41396b206cbfd63c58a8d2e35b8e79fec95 Mon Sep 17 00:00:00 2001
From: haturatu <haturatu@users.noreply.github.com>
Date: Sat, 6 Sep 2026 00:00:00 +0900
Subject: [PATCH] ipq5018: trace ECM TCP defer state machine

Record the ECM frontend state at the point a TCP rule is deferred. This
shows whether the guard leaves a connection or the global NSS frontend in
a pending state, without changing the defer behavior.

Signed-off-by: haturatu <haturatu@users.noreply.github.com>
---
 qca-nss-ecm/patches/0032-ipq5018-ecm-tcp-defer-fsm-trace.patch | 88 +++++++++++++
 1 file changed, 88 insertions(+)
 create mode 100644 qca-nss-ecm/patches/0032-ipq5018-ecm-tcp-defer-fsm-trace.patch

diff --git a/qca-nss-ecm/patches/0032-ipq5018-ecm-tcp-defer-fsm-trace.patch b/qca-nss-ecm/patches/0032-ipq5018-ecm-tcp-defer-fsm-trace.patch
new file mode 100644
index 0000000..95c6c44
--- /dev/null
+++ b/qca-nss-ecm/patches/0032-ipq5018-ecm-tcp-defer-fsm-trace.patch
@@ -0,0 +1,88 @@
+diff --git a/ecm_db/ecm_db_connection.c b/ecm_db/ecm_db_connection.c
+index 65431a7..b67523f 100644
+--- a/ecm_db/ecm_db_connection.c
++++ b/ecm_db/ecm_db_connection.c
+@@ -747,6 +747,23 @@ uint16_t ecm_db_connection_regeneration_occurrances_get(struct ecm_db_connection
+ }
+ EXPORT_SYMBOL(ecm_db_connection_regeneration_occurrances_get);
+ 
++/*
++ * ecm_db_connection_regeneration_required_get()
++ *	Return the outstanding regeneration request count.
++ */
++uint16_t ecm_db_connection_regeneration_required_get(struct ecm_db_connection_instance *ci)
++{
++	uint16_t required;
++
++	DEBUG_CHECK_MAGIC(ci, ECM_DB_CONNECTION_INSTANCE_MAGIC, "%px: magic failed", ci);
++
++	spin_lock_bh(&ecm_db_lock);
++	required = ci->regen_required;
++	spin_unlock_bh(&ecm_db_lock);
++	return required;
++}
++EXPORT_SYMBOL(ecm_db_connection_regeneration_required_get);
++
+ /*
+  * ecm_db_connection_regeneration_completed()
+  *	Re-generation was completed successfully
+diff --git a/ecm_db/ecm_db_connection.h b/ecm_db/ecm_db_connection.h
+index 14e90bd..498488d 100644
+--- a/ecm_db/ecm_db_connection.h
++++ b/ecm_db/ecm_db_connection.h
+@@ -360,6 +360,7 @@ int ecm_db_connection_iface_mtu_get(struct ecm_db_connection_instance *ci, ecm_d
+ ecm_db_iface_type_t ecm_db_connection_iface_type_get(struct ecm_db_connection_instance *ci, ecm_db_obj_dir_t dir);
+ 
+ uint16_t ecm_db_connection_regeneration_occurrances_get(struct ecm_db_connection_instance *ci);
++uint16_t ecm_db_connection_regeneration_required_get(struct ecm_db_connection_instance *ci);
+ void ecm_db_connection_regeneration_completed(struct ecm_db_connection_instance *ci);
+ void ecm_db_connection_regeneration_failed(struct ecm_db_connection_instance *ci);
+ bool ecm_db_connection_regeneration_required_check(struct ecm_db_connection_instance *ci);
+diff --git a/frontends/nss/ecm_nss_ported_ipv4.c b/frontends/nss/ecm_nss_ported_ipv4.c
+index 7c5a468..087eda6 100644
+--- a/frontends/nss/ecm_nss_ported_ipv4.c
++++ b/frontends/nss/ecm_nss_ported_ipv4.c
+@@ -354,6 +354,13 @@ static void ecm_nss_ported_ipv4_connection_accelerate(struct ecm_front_end_conne
+ 	bool flow_state_valid;
+ 	bool return_state_valid;
+ 	bool tcp_state_defer;
++	bool defer_can_accel;
++	bool defer_decelerate_pending;
++	int defer_accel_mode;
++	int defer_pending_accel_count;
++	int defer_pending_decel_count;
++	uint16_t defer_regen_required;
++	uint16_t defer_regen_occurrances;
+ 	uint8_t dest_mac_xlate[ETH_ALEN];
+ 	ecm_db_direction_t ecm_dir;
+ 	ecm_front_end_acceleration_mode_t result_mode;
+@@ -1292,6 +1299,17 @@ static void ecm_nss_ported_ipv4_connection_accelerate(struct ecm_front_end_conne
+ 			((ecm_nss_ported_ipv4_tcp_state_guard == 1 && !flow_state_valid && !return_state_valid) ||
+ 			(ecm_nss_ported_ipv4_tcp_state_guard >= 2 && (!flow_state_valid || !return_state_valid)));
+ 		if (tcp_state_defer) {
++			defer_regen_required = ecm_db_connection_regeneration_required_get(feci->ci);
++			defer_regen_occurrances = ecm_db_connection_regeneration_occurrances_get(feci->ci);
++			spin_lock_bh(&feci->lock);
++			spin_lock_bh(&ecm_nss_ipv4_lock);
++			defer_accel_mode = feci->accel_mode;
++			defer_decelerate_pending = feci->stats.decelerate_pending;
++			defer_can_accel = feci->can_accel;
++			defer_pending_accel_count = ecm_nss_ipv4_pending_accel_count;
++			defer_pending_decel_count = ecm_nss_ipv4_pending_decel_count;
++			spin_unlock_bh(&ecm_nss_ipv4_lock);
++			spin_unlock_bh(&feci->lock);
+ 			pr_info("ECM-TCP-DEFER: serial=%u mode=%u flow_ready=%u return_ready=%u flow_ws=%u flow_maxwin=%u flow_end=%u flow_maxend=%u ret_ws=%u ret_maxwin=%u ret_end=%u ret_maxend=%u\n",
+ 				ecm_db_connection_serial_get(feci->ci), ecm_nss_ported_ipv4_tcp_state_guard,
+ 				flow_state_valid, return_state_valid,
+@@ -1299,6 +1317,11 @@ static void ecm_nss_ported_ipv4_connection_accelerate(struct ecm_front_end_conne
+ 				tcp_ct.flow_end, tcp_ct.flow_max_end,
+ 				tcp_ct.return_window_scale, tcp_ct.return_max_window,
+ 				tcp_ct.return_end, tcp_ct.return_max_end);
++			pr_info("ECM-TCP-DEFER-FSM: serial=%u accel_mode=%d decelerate_pending=%u can_accel=%u pending_accel_total=%d pending_decel_total=%d regen_required=%u regen_occurrances=%u\n",
++				ecm_db_connection_serial_get(feci->ci), defer_accel_mode,
++				defer_decelerate_pending, defer_can_accel,
++				defer_pending_accel_count, defer_pending_decel_count,
++				defer_regen_required, defer_regen_occurrances);
+ 			goto ported_accel_defer;
+ 		}
+ 
-- 
2.50.1
