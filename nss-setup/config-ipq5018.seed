# vi: set syntax=make:
#
# IPQ5018 NSS production seed.
#
# The wired NSS driver is loaded automatically. ECM remains disabled by
# default so the wired NSS/ECM validation can still be run explicitly.
# Wi-Fi NSS is an opt-in experiment; use enable-ipq5018-wifi-nss.sh after
# copying this seed when testing it on a supported IPQ5018 board.

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_linksys_mx2000=y

# NSS dataplane, core driver, firmware, and ECM.
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_nss-firmware=y
CONFIG_PACKAGE_nss-firmware-ipq50xx=y

# The NSS core driver uses the package's normal kmodloader autoload path.
# /usr/sbin/nss-ipq5018-manual remains available for recovery and A/B tests.
# CONFIG_NSS_DRV_MANUAL_BRINGUP is not set

# IPQ5018 NSS uses the medium (512 MiB) memory profile.
CONFIG_NSS_MEM_PROFILE_MEDIUM=y

# Start with the firmware used by the existing NSS integration.
CONFIG_NSS_FIRMWARE_VERSION_11_4=y

# Use a workspace-local ccache in CI and on developer builds.
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# Keep Wi-Fi NSS out of the production wired-NSS default. It is enabled only
# by the explicit experimental opt-in helper.
# CONFIG_ATH11K_NSS_SUPPORT is not set
# CONFIG_ATH11K_NSS_MESH_SUPPORT is not set

# Test and failure analysis tools.
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_kmod-ramoops=y

# OpenWrt software flow offload must remain disabled for NSS measurements.
# Configure this in /etc/config/firewall on the device if an old config is kept.
